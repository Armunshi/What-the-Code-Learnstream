# Copy to .env and fill in. Vite only inlines VITE_-prefixed vars at BUILD
# time — on Vercel that means setting these in the project's Environment
# Variables dashboard is not enough on its own; the project must be redeployed
# for a change to take effect.

# Required. The backend API origin (see LearnStream/backend/.env's CORS_ORIGIN
# for the reverse direction).
VITE_BACKEND_URL=http://localhost:8000

# Required. Must match the backend's RAZORPAY_KEY_ID exactly — this is what
# the checkout modal authenticates with. If it's missing or doesn't match the
# key_id the order was created under on the backend, Razorpay's
# checkout/preferences endpoint returns 401 and checkout fails silently
# behind a generic "Payment Failed" alert (displayRazorpay.js fails fast if
# this is unset, but a mismatched-but-present value still 401s at Razorpay).
VITE_RAZORPAY_KEY_ID=
