# Copy to .env and fill in. config/env.js validates every entry at boot and
# refuses to start with a list of everything that is missing or malformed.

# --- server ---
# Optional. Defaults to 8000.
PORT=8000
# Optional. Defaults to "development". Set to "production" on the real host:
# it switches morgan to combined logging and strips stack traces from errors.
NODE_ENV=development
# Required. Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:2000

# --- database ---
# Required. Connection string WITHOUT the database name — constants.js appends it.
MONGODB_URI=mongodb://127.0.0.1:27017

# --- auth ---
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the values this project was scaffolded with; §1.4 wrote tokens to logs.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# --- cloudinary ---
# Required. Lecture video and assignment PDF storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- razorpay ---
# Required. Order creation and payment verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, but payment fulfilment is unreliable without it. This is the secret
# shown when you register the webhook in the Razorpay dashboard, NOT the key
# secret above. While it is unset the server still boots and everything else
# works, but POST /payment/webhook refuses every call, so an order is only
# fulfilled if the student's browser returns from checkout (BACKEND_AUDIT.md §2.8).
RAZORPAY_WEBHOOK_SECRET=

# --- hugging face (lecture-transcript RAG embeddings) ---
# Optional — nothing reads these yet outside src/services/rag. Get a token
# with "Make calls to Inference Providers" permission at
# https://huggingface.co/settings/tokens — every embed call 401s without one.
HF_API_TOKEN=
# BAAI/bge-base-en-v1.5, MIT-licensed, 768-dim. Changing this also requires
# updating QDRANT_EMBEDDING_DIM below to match the new model's output size.
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Qwen/Qwen2.5-7B-Instruct, Apache-2.0 (ungated, unlike Llama models which
# need a license click-through on huggingface.co before the API works).
# Powers POST .../lectures/:lecture_id/ask.
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- qdrant (lecture-transcript RAG vector store) ---
# All optional — nothing reads these yet outside `npm run qdrant:init`.
# Defaults point at the local Docker Compose service (docker-compose.yml).
QDRANT_URL=http://localhost:6333
# Blank for local dev (the Compose container sets no API key either).
# Required before Qdrant is reachable off localhost.
QDRANT_API_KEY=
QDRANT_COLLECTION=lecture_transcript_chunks
# Must match HF_EMBEDDING_MODEL's output size — 768 for BAAI/bge-base-en-v1.5.
QDRANT_EMBEDDING_DIM=768
