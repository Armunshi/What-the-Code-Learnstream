# Fixed test-only values (BACKEND_AUDIT.md §9.1) — real jsonwebtoken with a
# known secret, real schema validation via mongodb-memory-server, but nothing
# here is ever a live credential. MONGODB_URI is unused by the tests
# themselves (tests/setup.js connects to the ephemeral in-memory instance
# instead) but must be present or config/env.js refuses to boot the app.
NODE_ENV=test
PORT=8000
CORS_ORIGIN=http://localhost:2000
MONGODB_URI=mongodb://127.0.0.1:27017
ACCESS_TOKEN_SECRET=test-access-token-secret-do-not-use-in-prod
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=test-refresh-token-secret-do-not-use-in-prod
REFRESH_TOKEN_EXPIRY=10d
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-cloudinary-key
CLOUDINARY_API_SECRET=test-cloudinary-secret
RAZORPAY_KEY_ID=rzp_test_dummy_for_tests
RAZORPAY_KEY_SECRET=dummy-razorpay-secret-for-tests
